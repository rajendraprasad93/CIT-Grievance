# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ===================
# IDE and Editors
# ===================
.idea/
.vscode/
*.swp
*.swo
*~
.kiro/

# ===================
# Dependencies
# ===================
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===================
# Documentation (ALL .md files except README.md)
# ===================
*.md
!README.md

# ===================
# Testing
# ===================
/coverage
tests/
test/
__tests__/
test_*.py

# ===================
# Build & Production
# ===================
/.next/
/out/
/build
dist/
next-env.d.ts
*.tsbuildinfo
frontend/build/

# ===================
# Environment & Secrets (CRITICAL - NEVER COMMIT)
# ===================
.env
.env.local
.env.development
.env.production
.env.test
backend/.env
frontend/.env
**/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ===================
# Database Files
# ===================
*.db
*.sqlite
*.sqlite3
backend/*.db

# ===================
# Logs
# ===================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# ===================
# System Files
# ===================
.DS_Store
Thumbs.db
desktop.ini
*.bak

# ===================
# Python
# ===================
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
.Python
pip-log.txt

# ===================
# Development Tools
# ===================
.chainlit
.ipynb_checkpoints/
.ac
.emergent/
.cache/

# ===================
# Deployment
# ===================
.vercel

# ===================
# Archives & Large Files
# ===================
*.zip
*.tar.gz
*.tar
*.tgz
*.pack
*.deb
*.dylib
*.rar
*.7z

# ===================
# Images (project-specific unwanted)
# ===================
images-removebg-preview.png
cit-1.jpg

# ===================
# Misc Project Files
# ===================
design_guidelines.json

# ===================
# Uploads (keep folder structure, ignore contents)
# ===================
backend/uploads/*
!backend/uploads/.gitkeep
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep